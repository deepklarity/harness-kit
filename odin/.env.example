# ============================================================
# No .env file is needed for local development!
# Odin connects without auth when TaskIt has AUTH_ENABLED=False (the default).
# Only set these when TaskIt has AUTH_ENABLED=True:
# ============================================================

# ODIN_ADMIN_USER=admin@test.com
# ODIN_ADMIN_PASSWORD=test123

# Forced AI provider mode
# When set, Odin will use only this provider for system-selected flows.
# Allowed values: gemini
# FORCED_BASE_PROVIDER=gemini
# Optional: pin to an exact model on that provider
# FORCED_BASE_MODEL=gemini-2.5-pro
