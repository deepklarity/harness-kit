# ============================================================
# No .env file is needed for local development!
# All defaults point to http://localhost:8000 with auth disabled.
# Just run: ./dev.sh (from repo root)
# ============================================================

# VITE_HARNESS_TIME_API_URL=http://localhost:9100   # default, no need to set
# VITE_AUTH_ENABLED=false                           # default, no need to set
# VITE_INSTANCE=dev                                 # instance label: adds [DEV] badge, amber theme, wrench favicon
