# ============================================================
# No .env file is needed for local development!
# All defaults work out of the box with SQLite + filesystem broker.
# Just run: ./dev.sh (from repo root)
# ============================================================

# --- Django ---
# SECRET_KEY=change-me-in-production   # has a dev default built in
# DEBUG=True                           # default: True

# --- Database ---
# Default: SQLite (zero config). Set USE_SQLITE=False for PostgreSQL:
# USE_SQLITE=False
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=taskit
# DB_USER=postgres
# DB_PASSWORD=admin123

# --- Authentication ---
# Default: disabled. Set AUTH_ENABLED=True to require JWT auth.
# AUTH_ENABLED=False
# JWT_ACCESS_SECONDS=900
# JWT_REFRESH_SECONDS=604800
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Odin execution ---
# Default: celery_dag with filesystem broker (no Redis needed).
# ODIN_EXECUTION_STRATEGY=celery_dag   # default
# ODIN_CLI_PATH=odin
# ODIN_WORKING_DIR=/path/to/project/with/.odin

# --- Forced AI provider mode ---
# When set, TaskIt/Odin will use only this provider for system-selected AI flows.
# Allowed values: gemini
# FORCED_BASE_PROVIDER=gemini
# Optional: pin to an exact model on that provider
# FORCED_BASE_MODEL=gemini-2.5-pro

# --- Celery broker ---
# Default: filesystem broker (zero config). Set USE_FILESYSTEM_BROKER=False for Redis:
# USE_FILESYSTEM_BROKER=False
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Merge watchdog (W3.22 / task #171) ---
# Scans for tasks whose latest reflection PASSed but whose post-PASS merge
# dispatch hasn't completed. Retries once, then marks needs_human so the
# operator sees the stall on the board.
# MERGE_WATCHDOG_SCAN_INTERVAL_SECONDS=60   # celery-beat cadence
# MERGE_WATCHDOG_MINUTES_IDLE=10             # minutes since dispatch before retry
# MERGE_WATCHDOG_MAX_ATTEMPTS=1              # retries before needs_human escalation

# --- Reflection watchdog (task #221) ---
# Scans for REVIEW tasks whose reflection was lost (host slept, worker
# died, broker dropped the message). Reaps stale PENDING/RUNNING reports,
# retries with the size-scaled reviewer, then escalates with a comment
# naming what failed (the reflect log tail).
# REFLECTION_WATCHDOG_SCAN_INTERVAL_SECONDS=60
# REFLECTION_WATCHDOG_MINUTES_IDLE=35        # must exceed the 30min reflection timeout
# REFLECTION_WATCHDOG_MAX_ATTEMPTS=2
# REFLECTION_WATCHDOG_NO_REVIEWER_SKIPS_BEFORE_ESCALATION=3  # consecutive no-reviewer scans before the watchdog pages the operator (task #246)

# --- Planning UI / WebSocket (Django Channels) ---
# URL that odin uses to POST back to the backend during planning
# TASKIT_INTERNAL_URL=http://localhost:8000
# Channel layer: InMemoryChannelLayer in dev (USE_SQLITE=True), Redis in prod
# REDIS_URL=redis://localhost:6379/1
# Dedicated celery queue for merges so 10s merge jobs never wait behind
# long sandbox executions. dev.sh sets this and starts the queue's worker.
# MERGE_QUEUE_NAME=merges
# Dedicated celery queue for reflections so reviews never wait behind the
# 3-slot execution pool. dev.sh sets this and starts the queue's worker.
# REFLECTION_QUEUE_NAME=reflections
